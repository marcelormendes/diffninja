{
  "name": "prismr",
  "version": "0.1.0",
  "private": true,
  "description": "Focused local PR reviews with calldiff and Jev",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "prismr": "dist/review/cli.js",
    "calldiff": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/review/cli.ts",
    "start": "node dist/review/cli.js",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelormendes/prismr.git"
  },
  "bugs": {
    "url": "https://github.com/marcelormendes/prismr/issues"
  },
  "homepage": "https://github.com/marcelormendes/prismr#readme",
  "keywords": [
    "callgraph",
    "diff",
    "callstack",
    "tree-sitter",
    "git",
    "multi-language",
    "typescript",
    "python",
    "rust",
    "go"
  ],
  "author": "Tanishq Kancharla",
  "license": "MIT",
  "dependencies": {
    "incur": "^0.4.26",
    "picocolors": "^1.1.1",
    "tree-sitter": "^0.25.1",
    "tree-sitter-typescript": "^0.23.2"
  },
  "overrides": {
    "tree-sitter-typescript": {
      "tree-sitter": "$tree-sitter"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.79.0",
    "@types/node": "^24.2.0",
    "outdent": "^0.8.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
